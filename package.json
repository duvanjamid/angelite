{
  "name": "@duvanjamid/angelite",
  "version": "1.0.0",
  "description": "A signals-based framework with Angular-style templates, small enough to run straight in the browser",
  "main": "dist/angelite.min.js",
  "module": "dist/angelite.esm.js",
  "unpkg": "dist/angelite.min.js",
  "files": [
    "dist",
    "tools",
    "types",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "http-server -c-1 .",
    "test": "node --test tests/*.test.mjs",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build",
    "build:docs": "echo \"The documentation lives in https://github.com/duvanjamid/angelite-docs: run its scripts/sync.mjs against this checkout\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-include=\"src/utils/expression.js\" --test-coverage-include=\"src/ui/**\" --test-coverage-lines=95 --test-coverage-branches=88 --test-coverage-functions=95 tests/*.test.mjs",
    "size": "node scripts/check-size.mjs",
    "typecheck": "tsc -p types/tsconfig.json",
    "size:apps": "node scripts/check-app-size.mjs",
    "perf": "cd benchmarks && BUILD=angelite-aot,angelite,preact node build.mjs && FW=angelite-aot,angelite,preact ROUNDS=5 ITER=15 STARTUP_RUNS=25 node run.mjs && node compare.mjs"
  },
  "keywords": [
    "framework",
    "frontend",
    "angular",
    "signals",
    "lightweight",
    "browser",
    "components",
    "reactive",
    "routing",
    "forms"
  ],
  "author": "Duvan Vargas",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duvanjamid/angelite.git"
  },
  "bugs": {
    "url": "https://github.com/duvanjamid/angelite/issues"
  },
  "homepage": "https://github.com/duvanjamid/angelite#readme",
  "devDependencies": {
    "esbuild": "^0.25.12",
    "http-server": "^14.1.1",
    "jsdom": "^30.1.3",
    "rollup": "^2.79.1",
    "rollup-plugin-terser": "^7.0.2",
    "typescript": "5.9"
  },
  "type": "module",
  "sideEffects": [
    "./src/jit.js",
    "./src/pipes.js",
    "./src/full.js",
    "./src/index.js",
    "./src/portal.js",
    "./src/defer.js",
    "./src/refs.js",
    "./src/animate.js",
    "./src/ui/*",
    "./dist/angelite.esm.js",
    "./dist/angelite.min.js",
    "./dist/angelite-pipes.esm.js",
    "./dist/angelite-runtime-plus.esm.js",
    "./dist/angelite-runtime-plus.min.js",
    "./dist/angelite-testing.esm.js",
    "./dist/angelite-devtools.esm.js",
    "./dist/angelite-addons.min.js",
    "./dist/angelite-ui.esm.js",
    "./dist/angelite-ui.min.js"
  ],
  "exports": {
    ".": {
      "types": "./types/angelite.d.ts",
      "import": "./dist/angelite.esm.js",
      "default": "./dist/angelite.min.js"
    },
    "./runtime": {
      "types": "./types/angelite.d.ts",
      "import": "./dist/angelite-runtime.esm.js",
      "default": "./dist/angelite-runtime.min.js"
    },
    "./runtime-plus": {
      "types": "./types/angelite.d.ts",
      "import": "./dist/angelite-runtime-plus.esm.js",
      "default": "./dist/angelite-runtime-plus.min.js"
    },
    "./pipes": {
      "import": "./dist/angelite-pipes.esm.js"
    },
    "./testing": {
      "types": "./types/testing.d.ts",
      "import": "./dist/angelite-testing.esm.js"
    },
    "./forms": {
      "types": "./types/forms.d.ts",
      "import": "./dist/angelite-forms.esm.js"
    },
    "./http": {
      "types": "./types/http.d.ts",
      "import": "./dist/angelite-http.esm.js"
    },
    "./i18n": {
      "types": "./types/i18n.d.ts",
      "import": "./dist/angelite-i18n.esm.js"
    },
    "./devtools": {
      "types": "./types/devtools.d.ts",
      "import": "./dist/angelite-devtools.esm.js"
    },
    "./hydrate": {
      "types": "./types/hydrate.d.ts",
      "import": "./dist/angelite-hydrate.esm.js"
    },
    "./addons": {
      "types": "./types/forms.d.ts",
      "default": "./dist/angelite-addons.min.js"
    },
    "./ui": {
      "types": "./types/ui.d.ts",
      "import": "./dist/angelite-ui.esm.js",
      "default": "./dist/angelite-ui.min.js"
    },
    "./ui/meta": {
      "types": "./types/ui-meta.d.ts",
      "default": "./src/ui/meta.js"
    },
    "./tools/aot.mjs": {
      "types": "./types/aot.d.mts",
      "default": "./tools/aot.mjs"
    },
    "./tools/ssr.mjs": {
      "types": "./types/ssr.d.mts",
      "default": "./tools/ssr.mjs"
    },
    "./tools/vite.mjs": {
      "types": "./types/vite.d.mts",
      "default": "./tools/vite.mjs"
    },
    "./tools/check.mjs": {
      "types": "./types/check.d.mts",
      "default": "./tools/check.mjs"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "jsdom": ">=22"
  },
  "peerDependenciesMeta": {
    "jsdom": {
      "optional": true
    }
  },
  "types": "types/angelite.d.ts",
  "bin": {
    "angelite-check": "tools/check.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
