{
  "name": "@duvanjamid/angelite",
  "version": "2.0.0",
  "description": "A lightweight Angular-inspired framework that runs directly in the browser",
  "main": "dist/angelite.js",
  "module": "dist/angelite.esm.js",
  "unpkg": "dist/angelite.min.js",
  "files": [
    "dist",
    "tools",
    "src/lite",
    "src/utils",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "http-server -c-1 .",
    "test": "node --test \"tests/*.test.mjs\"",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build",
    "build:docs": "rollup -c && cp dist/angelite-lite.min.js dist/angelite-ui.min.js docs/"
  },
  "keywords": [
    "framework",
    "frontend",
    "angular",
    "lightweight",
    "browser",
    "components",
    "reactive",
    "routing",
    "forms"
  ],
  "author": "Duvan Vargas",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duvanjamid/angelite.git"
  },
  "bugs": {
    "url": "https://github.com/duvanjamid/angelite/issues"
  },
  "homepage": "https://github.com/duvanjamid/angelite#readme",
  "devDependencies": {
    "http-server": "^14.1.1",
    "jsdom": "^29.1.1",
    "rollup": "^2.79.1",
    "rollup-plugin-terser": "^7.0.2"
  },
  "type": "module",
  "sideEffects": [
    "./src/angelite.js",
    "./src/core/*",
    "./src/decorators/*",
    "./src/directives/*",
    "./src/forms/*",
    "./src/pipes/*",
    "./src/router/*",
    "./src/ui/*",
    "./dist/angelite.js",
    "./dist/angelite.esm.js",
    "./dist/angelite.min.js",
    "./dist/angelite-ui.esm.js",
    "./dist/angelite-ui.min.js",
    "./src/lite/jit.js",
    "./src/lite/pipes.js",
    "./src/lite/full.js",
    "./src/lite/index.js",
    "./dist/angelite-lite.esm.js",
    "./dist/angelite-lite.min.js",
    "./dist/angelite-pipes.esm.js"
  ],
  "exports": {
    ".": {
      "import": "./dist/angelite.esm.js",
      "default": "./dist/angelite.js"
    },
    "./lite": {
      "import": "./dist/angelite-lite.esm.js",
      "default": "./dist/angelite-lite.min.js"
    },
    "./ui": {
      "import": "./dist/angelite-ui.esm.js",
      "default": "./dist/angelite-ui.min.js"
    },
    "./lite/runtime": {
      "import": "./dist/angelite-runtime.esm.js",
      "default": "./dist/angelite-runtime.min.js"
    },
    "./lite/pipes": {
      "import": "./dist/angelite-pipes.esm.js"
    },
    "./tools/aot.mjs": "./tools/aot.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "jsdom": ">=22"
  },
  "peerDependenciesMeta": {
    "jsdom": {
      "optional": true
    }
  }
}
